# Supabase (센텐스크래프트)
#
# 주의: service-role key는 브라우저·public-config·클라이언트 코드에 노출하면 안 됩니다.
# SUPABASE_SERVICE_ROLE_KEY는 서버 전용 alignment 배치 저장 모듈에서만 사용하세요.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 게시판 운영 API (migration 적용 후에만 true)
BOARD_OPERATIONAL=
# 게시판 데이터 모드: LEGACY_LOCAL | API_DRY_RUN | API_OPERATIONAL (기본 LEGACY_LOCAL)
BOARD_DATA_MODE=
# 개발용 메모리 게시판 API (실데이터 아님)
BOARD_DEV_MEMORY=

# alignment live 검증 (테스트 프로젝트만). true가 아니면 쓰기 검증을 실행하지 않음.
ALIGNMENT_LIVE_VERIFY=
# SUPABASE_URL의 project ref와 일치해야 쓰기 검증 허용 (예: abcdxyz)
ALIGNMENT_VERIFY_PROJECT_REF=
# 테스트용 auth.users.id (운영 사용자 금지)
ALIGNMENT_VERIFY_TEST_USER_ID=
# true면 검증 후 테스트 행 삭제
ALIGNMENT_VERIFY_CLEANUP=

# 데일리 이슈 검수 DB (6차) — 개발/테스트 전용. 운영 DATABASE_URL 자동 사용 금지.
# DAILY_ISSUE_REPOSITORY=json|db (기본 json)
DAILY_ISSUE_REPOSITORY=
# PostgreSQL connection string for daily-issue only (never log the password)
DAILY_ISSUE_DATABASE_URL=
# Schema: public 또는 daily_issue_test / daily_issue_dev*
DAILY_ISSUE_DB_SCHEMA=
# 1 이면 db repository 활성 힌트 (URL 없으면 여전히 fail-closed)
DAILY_ISSUE_DB_ENABLED=
# 테스트 reset / migration apply 게이트
DAILY_ISSUE_ALLOW_TEST_RESET=
DAILY_ISSUE_APPLY_MIGRATION_IN_TEST=

# 데일리 이슈 API 1차 (7차) — 관리자 임시 비밀토큰 (정식 관리자 인증 아님)
# Authorization: Bearer <token> 만 허용. query string 금지. 브라우저 번들 포함 금지.
DAILY_ISSUE_ADMIN_API_TOKEN=
# 데일리 이슈 API CORS allowlist (쉼표 구분). 미설정 시 개발에서 localhost:3000 허용
DAILY_ISSUE_API_CORS_ORIGINS=

# 서버 포트 (선택)
PORT=3000

# 브라우저 자동 열기 (선택: 1 / true / yes)
OPEN_BROWSER=

# OAuth 리다이렉트 고정 origin (선택)
APP_PUBLIC_ORIGIN=
