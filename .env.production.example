# =============================================================================
# 센텐스아레나 — Production / Railway 환경변수 템플릿
# =============================================================================
# 실제 비밀값은 Railway Variables에만 입력. 이 파일에 값을 채운 채 커밋하지 마세요.
# Canonical origin: https://sentencearena.com
# Healthcheck: GET /health  ·  앱 준비: GET /ready
# 첫 배포: 정치성향 scheduler OFF · 외계 moderation OFF · Daily Issue morning scheduler OFF
# =============================================================================

# -----------------------------------------------------------------------------
# A. 필수 (첫 Railway Deploy 전 Variables에 설정)
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_PUBLIC_ORIGIN=https://sentencearena.com

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# (대안) SUPABASE_ANON_KEY=
# Auth 로그인 경로에 사용하지 않음. 업적/영토 count/alignment persist 서버 전용.
SUPABASE_SERVICE_ROLE_KEY=

BOARD_OPERATIONAL=true
TERRITORY_EVOLUTION_OPERATIONAL=true

DAILY_ISSUE_REPOSITORY=db
DAILY_ISSUE_DATABASE_URL=
DAILY_ISSUE_DB_SCHEMA=daily_issue

# CORS. 비우면 APP_PUBLIC_ORIGIN만 허용. www는 현재 사용 계획 없음.
# DAILY_ISSUE_API_CORS_ORIGINS=https://sentencearena.com

POLITICAL_ALIGNMENT_SCHEDULER_ENABLED=false
ALIEN_MODERATION_V1=false
DAILY_ISSUE_MORNING_SCHEDULER_ENABLED=0

# PORT 는 Railway가 자동 주입 — 수동 설정 불필요
# HOST 기본 0.0.0.0 (server.js)

# -----------------------------------------------------------------------------
# B. 첫 배포 후 추가/활성화 (수동 확인 후)
# -----------------------------------------------------------------------------
# TRUST_PROXY=1
#   Railway 리버스 프록시 뒤 HTTPS·Host 인식. OAuth redirect 확인 후 권장.
#
# DAILY_ISSUE_MORNING_SCHEDULER_ENABLED=1
#   운영 daily_issue schema migration · /ready 200 · 관리자 smoke 후. web replica=1 유지.
#
# POLITICAL_ALIGNMENT_SCHEDULER_ENABLED=true
#   Asia/Seoul 05:00/17:00. missed catch-up 없음. 첫 배포 OFF.
#
# ALIEN_MODERATION_V1=true
#   자동 외계행 persist. 첫 배포 OFF.
#
# SHUTDOWN_TIMEOUT_MS=10000
#
# DAILY_ISSUE_CONFIRM_PRODUCTION_MIGRATION=APPLY_DAILY_ISSUE_PRODUCTION
#   운영 Daily Issue schema migration apply 시에만 일시 설정. 적용 후 즉시 제거.

# -----------------------------------------------------------------------------
# C. OAuth
# -----------------------------------------------------------------------------
# 카카오/네이버/구글 client secret은 Railway가 아니라 Supabase Auth 대시보드에 둔다.
# 콜백: https://<project>.supabase.co/auth/v1/callback
# redirect: https://sentencearena.com/auth-v2/callback.html
# 서버 env에 OAuth client secret을 새로 만들지 않는다.

# -----------------------------------------------------------------------------
# D. 절대 넣으면 안 되는 개발 플래그 (boot guard fail-closed)
# -----------------------------------------------------------------------------
# DAILY_ISSUE_ALLOW_TEST_RESET
# DAILY_ISSUE_APPLY_MIGRATION_IN_TEST
# DAILY_ISSUE_MORNING_RUN_KEY_NAMESPACE
# DAILY_ISSUE_ADMIN_API_TOKEN
# BOARD_DEV_MEMORY
# ALIGNMENT_LIVE_VERIFY
# ALIGNMENT_VERIFY_PROJECT_REF
# ALIGNMENT_VERIFY_TEST_USER_ID
# ALIGNMENT_VERIFY_CLEANUP
# OPEN_BROWSER
# ALIEN_MODERATION_ADMIN_BYPASS
# DAILY_ISSUE_DB_SCHEMA=daily_issue_test
# DAILY_ISSUE_DB_SCHEMA=public
# DAILY_ISSUE_REPOSITORY=json
# APP_PUBLIC_ORIGIN=http://localhost:3000
