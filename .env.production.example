# =============================================================================
# 센텐스아레나 — 운영(베타) / Railway 환경변수 템플릿
# =============================================================================
# 실제 비밀값은 Railway Variables에만 입력. 이 파일에 값을 채운 채 커밋하지 마세요.
# schema: DAILY_ISSUE_DB_SCHEMA=daily_issue 고정 (daily_issue_test / public 금지)
# 첫 배포: DAILY_ISSUE_MORNING_SCHEDULER_ENABLED=0 · web instance = 1
# Healthcheck: GET /health  (Railway)  ·  앱 준비: GET /ready
# =============================================================================

# -----------------------------------------------------------------------------
# A. 필수 (첫 배포 전 Railway Variables에 설정)
# -----------------------------------------------------------------------------
NODE_ENV=production

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# (대안) SUPABASE_ANON_KEY=

DAILY_ISSUE_REPOSITORY=db
DAILY_ISSUE_DATABASE_URL=
DAILY_ISSUE_DB_SCHEMA=daily_issue

# Railway가 부여하는 공개 URL origin (예: https://xxx.up.railway.app)
# 커스텀 도메인 사용 시 그 origin. 쉼표로 여러 개 가능(CORS).
APP_PUBLIC_ORIGIN=
DAILY_ISSUE_API_CORS_ORIGINS=

# 첫 배포: 스케줄러 OFF (smoke·migration·관리자 로그인 확인 후 B에서 1)
DAILY_ISSUE_MORNING_SCHEDULER_ENABLED=0

# PORT 는 Railway가 자동 주입 — 보통 수동 설정 불필요
# HOST 기본 0.0.0.0 (server.js) — 변경 불필요

# -----------------------------------------------------------------------------
# B. 첫 배포 후 추가/활성화
# -----------------------------------------------------------------------------
# TRUST_PROXY=1
#   Railway 리버스 프록시 뒤 HTTPS·Host 인식용. OAuth/redirect 안정화 후 권장.
#
# DAILY_ISSUE_MORNING_SCHEDULER_ENABLED=1
#   운영 migration·/ready·관리자 Auth smoke 통과 후, web replica=1 유지한 채 활성화.
#
# SHUTDOWN_TIMEOUT_MS=10000
#   graceful shutdown 강제 종료(ms). 기본 10000.
#
# DAILY_ISSUE_CONFIRM_PRODUCTION_MIGRATION=APPLY_DAILY_ISSUE_PRODUCTION
#   운영 migration apply 시에만 일시 설정. 적용 후 즉시 제거.
#
# DAILY_ISSUE_MORNING_COLLECT_CRON / DAILY_ISSUE_MORNING_PUBLISH_CRON
#   기본값(04:30 / 05:00 KST) 유지 시 생략 가능.

# -----------------------------------------------------------------------------
# C. 절대 넣으면 안 되는 개발 플래그 (boot guard fail-closed / 보안)
# -----------------------------------------------------------------------------
# DAILY_ISSUE_ALLOW_TEST_RESET
# DAILY_ISSUE_APPLY_MIGRATION_IN_TEST
# DAILY_ISSUE_MORNING_RUN_KEY_NAMESPACE
# DAILY_ISSUE_ADMIN_API_TOKEN
# BOARD_DEV_MEMORY
# ALIGNMENT_LIVE_VERIFY
# ALIGNMENT_VERIFY_PROJECT_REF
# ALIGNMENT_VERIFY_TEST_USER_ID
# ALIGNMENT_VERIFY_CLEANUP
# OPEN_BROWSER
# DAILY_ISSUE_DB_SCHEMA=daily_issue_test
# DAILY_ISSUE_DB_SCHEMA=public
# DAILY_ISSUE_REPOSITORY=json
